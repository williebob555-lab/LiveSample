{
  "name": "sampler-app",
  "productName": "LiveSample",
  "version": "0.1.0",
  "description": "Build professional multisampled instruments fast — capture, analyze, map, and export to SFZ, DecentSampler and Ableton.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:host",
    "build:host": "node scripts/build-host.mjs",
    "typecheck": "tsc --noEmit",
    "selftest": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/selftest.mjs --log-level=error && node node_modules/.cache/selftest.mjs",
    "test:audio": "npm run build:host && electron scripts/test-host.cjs",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "install:desktop": "bash scripts/install-linux.sh",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never",
    "release": "npm run build && electron-builder --publish always",
    "brand": "electron scripts/make-brand.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "audify": "^1.10.1",
    "electron-updater": "^6.8.9"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/williebob555-lab/LiveSample.git"
  },
  "author": "williebob555-lab",
  "desktopName": "livesample.desktop"
}
