{
  "name": "sampler-app",
  "productName": "Sampler",
  "version": "0.1.0",
  "description": "Build professional multisampled instruments fast — capture, analyze, map, and export to SFZ, DecentSampler, Ableton and LivePatch.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:host",
    "build:host": "node scripts/build-host.mjs",
    "typecheck": "tsc --noEmit",
    "selftest": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/selftest.mjs --log-level=error && node node_modules/.cache/selftest.mjs",
    "test:audio": "npm run build:host && electron scripts/test-host.cjs",
    "start": "npm run build && electron .",
    "electron": "electron ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^37.10.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "audify": "^1.10.1"
  }
}
